# Copy to .env and fill in. Never share your real .env.

# The exact hostname this server answers on. It must already point at this
# machine's public IP before you start the stack, or the free certificate
# cannot be issued.
#
#   your own domain:  DOMAIN=library.example.com
#   free DuckDNS:     DOMAIN=yourname.duckdns.org
#
# Not needed at all for the plain HTTP variant.
DOMAIN=library.example.com
